{
  "name": "docflow-professional",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sw.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:production": "playwright test --config=playwright.production.config.ts --project=chromium",
    "preview": "vite preview"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.10.2",
    "eslint": "9.39.5",
    "globals": "15.14.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
