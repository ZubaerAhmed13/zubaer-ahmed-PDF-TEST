{
  "name": "docflow-professional",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/stage-ocr-assets.mjs && node scripts/stage-native-assets.mjs && vite",
    "build": "node scripts/stage-ocr-assets.mjs && node scripts/stage-native-assets.mjs && tsc -b && vite build && node scripts/generate-sw.mjs",
    "build:preview": "npm run build && node scripts/build-vercel-preview.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "pretest": "node scripts/stage-native-assets.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:production": "playwright test --config=playwright.production.config.ts --project=chromium",
    "preview": "vite preview",
    "benchmark:ocr": "node scripts/stage-ocr-assets.mjs && node scripts/benchmark-ocr.mjs",
    "verify:provenance": "node scripts/verify-provenance.mjs",
    "release:artifact": "node scripts/release-artifact.mjs",
    "check:availability": "node scripts/check-availability.mjs"
  },
  "dependencies": {
    "@embedpdf/pdfium": "2.15.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.10.2",
    "eslint": "9.39.5",
    "globals": "15.14.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "license": "UNLICENSED"
}
